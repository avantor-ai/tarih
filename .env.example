# Gemini API кілті — https://aistudio.google.com/apikey
# Бұл файлды .env деп көшіріп, кілтіңізді қойыңыз.
# Кілт болмаса да сайт толық жұмыс істейді: тек демо режимі қосулы болады.
GEMINI_API_KEY=

# Қолданылатын модель (қажет болса өзгертіңіз)
GEMINI_MODEL=gemini-2.5-flash

API_PORT=8787

# Жариялы сайтта AI режимін әдейі өшіру үшін (Vercel айнымалысы):
#   AI_ENABLED=false  → сайт тек демо режимінде жұмыс істейді
# Кілт ашық тұрған сайтта кез келген адам жұмсай алатынын ұмытпаңыз.
AI_ENABLED=true

# Болашақта Anthropic-ке көшкенде: gemini | anthropic
AI_PROVIDER=gemini
